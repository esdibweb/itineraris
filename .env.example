# Variables for docker-compose.yml (e.g. Portainer stack > Environment variables).
# Copy to .env and fill in real values; never commit the real file.

# Image published by the GitHub workflow (lowercase owner/repository)
APP_IMAGE=ghcr.io/esdibweb/itineraris:latest
# Port on the VM that the reverse proxy forwards to
APP_PORT=8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Space-separated host names
DJANGO_ALLOWED_HOSTS=apps.escoladisseny.com

POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=change-me
# Must be at least the version that created any dump you restore
POSTGRES_VERSION=17
BACKUP_KEEP_DAYS=14

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sender of notification emails (optional)
# DEFAULT_FROM_EMAIL=no-reply@escoladisseny.com

# Email domains that can create an account with Google (space-separated; optional)
# ALLOWED_SIGNUP_DOMAINS=escoladisseny.com alum.escoladisseny.com
# HTTP Strict Transport Security in seconds (optional; default 30 days, 0 disables)
# SECURE_HSTS_SECONDS=2592000
